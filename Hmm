local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local GuiService = game:GetService("GuiService")

local Library = {}

function Library:CreateWindow(titleText)
	titleText = titleText or "Control Panel"

	local localPlayer = Players.LocalPlayer
	local playerGui = localPlayer:WaitForChild("PlayerGui")

	if playerGui:FindFirstChild("TabbedLibraryGUI") then
		playerGui.TabbedLibraryGUI:Destroy()
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "TabbedLibraryGUI"
	screenGui.ResetOnSpawn = false
	screenGui.DisplayOrder = 999
	screenGui.IgnoreGuiInset = true

	-- Prevent mobile safe-area margins from clipping left/right edges
	pcall(function()
		screenGui.ScreenInsets = Enum.ScreenInsets.None
	end)
	pcall(function()
		screenGui.ClipToDeviceSafeArea = false
	end)

	screenGui.Parent = playerGui

	-- Dynamically detect the Roblox top bar height for PC and mobile
	local topInset = GuiService:GetGuiInset().Y
	if topInset <= 0 then
		topInset = 36
	end

	-- Custom Image Toggle Icon (Positioned below the Roblox top menu bar)
	local toggleBtn = Instance.new("ImageButton")
	toggleBtn.Name = "ToggleIcon"
	toggleBtn.Size = UDim2.new(0, 36, 0, 36)
	toggleBtn.Position = UDim2.new(0.5, -18, 0, topInset + 6)
	toggleBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
	toggleBtn.Image = "rbxassetid://110083736169025"
	toggleBtn.ZIndex = 1000
	toggleBtn.AutoButtonColor = false
	toggleBtn.Parent = screenGui

	local toggleCorner = Instance.new("UICorner")
	toggleCorner.CornerRadius = UDim.new(0, 8)
	toggleCorner.Parent = toggleBtn

	local toggleStroke = Instance.new("UIStroke")
	toggleStroke.Color = Color3.fromRGB(60, 60, 72)
	toggleStroke.Thickness = 1
	toggleStroke.Parent = toggleBtn

	-- 0.5 Black Overlay
	local overlay = Instance.new("Frame")
	overlay.Name = "ScreenOverlay"
	overlay.Size = UDim2.new(1, 0, 1, -topInset)
	overlay.Position = UDim2.new(0, 0, 0, topInset)
	overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	overlay.BackgroundTransparency = 0.5
	overlay.BorderSizePixel = 0
	overlay.Visible = true
	overlay.ZIndex = 1
	overlay.Parent = screenGui

	-- Dynamic top inset updates
	GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(function()
		local currentInset = GuiService:GetGuiInset().Y
		if currentInset > 0 then
			overlay.Position = UDim2.new(0, 0, 0, currentInset)
			overlay.Size = UDim2.new(1, 0, 1, -currentInset)
			toggleBtn.Position = UDim2.new(0.5, -18, 0, currentInset + 6)
		end
	end)

	-- Main Menu Frame
	local mainFrame = Instance.new("Frame")
	mainFrame.Name = "MainFrame"
	mainFrame.Size = UDim2.new(0.85, 0, 0.82, 0)
	mainFrame.Position = UDim2.new(0.075, 0, 0.1, 0)
	mainFrame.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
	mainFrame.BackgroundTransparency = 0.15
	mainFrame.BorderSizePixel = 0
	mainFrame.ZIndex = 2
	mainFrame.Parent = overlay

	local frameCorner = Instance.new("UICorner")
	frameCorner.CornerRadius = UDim.new(0, 8)
	frameCorner.Parent = mainFrame

	-- Top Bar
	local topBar = Instance.new("Frame")
	topBar.Name = "TopBar"
	topBar.Size = UDim2.new(1, 0, 0, 32)
	topBar.BackgroundTransparency = 1
	topBar.ZIndex = 3
	topBar.Parent = mainFrame

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.new(1, -40, 1, 0)
	titleLabel.Position = UDim2.new(0, 12, 0, 0)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = titleText
	titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	titleLabel.TextSize = 15
	titleLabel.Font = Enum.Font.SourceSansBold
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.ZIndex = 4
	titleLabel.Parent = topBar

	local closeBtn = Instance.new("TextButton")
	closeBtn.Size = UDim2.new(0, 24, 0, 24)
	closeBtn.Position = UDim2.new(1, -28, 0, 4)
	closeBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
	closeBtn.Text = "X"
	closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	closeBtn.TextSize = 12
	closeBtn.Font = Enum.Font.SourceSansBold
	closeBtn.ZIndex = 4
	closeBtn.Parent = topBar

	local closeCorner = Instance.new("UICorner")
	closeCorner.CornerRadius = UDim.new(0, 4)
	closeCorner.Parent = closeBtn

	-- Toggle Menu Functions
	local function setMenuVisible(visible)
		overlay.Visible = visible
	end

	closeBtn.MouseButton1Click:Connect(function()
		setMenuVisible(false)
	end)

	toggleBtn.MouseButton1Click:Connect(function()
		setMenuVisible(not overlay.Visible)
	end)

	-- Left Sidebar (Tabs Container)
	local sidebar = Instance.new("ScrollingFrame")
	sidebar.Name = "Sidebar"
	sidebar.Size = UDim2.new(0, 130, 1, -40)
	sidebar.Position = UDim2.new(0, 8, 0, 36)
	sidebar.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
	sidebar.BackgroundTransparency = 0.3
	sidebar.BorderSizePixel = 0
	sidebar.ScrollBarThickness = 2
	sidebar.CanvasSize = UDim2.new(0, 0, 0, 0)
	sidebar.ZIndex = 3
	sidebar.Parent = mainFrame

	local sidebarCorner = Instance.new("UICorner")
	sidebarCorner.CornerRadius = UDim.new(0, 6)
	sidebarCorner.Parent = sidebar

	local sidebarLayout = Instance.new("UIListLayout")
	sidebarLayout.Padding = UDim.new(0, 4)
	sidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder
	sidebarLayout.Parent = sidebar

	sidebarLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		sidebar.CanvasSize = UDim2.new(0, 0, 0, sidebarLayout.AbsoluteContentSize.Y + 8)
	end)

	-- Right Content Area
	local contentArea = Instance.new("Frame")
	contentArea.Name = "ContentArea"
	contentArea.Size = UDim2.new(1, -154, 1, -40)
	contentArea.Position = UDim2.new(0, 146, 0, 36)
	contentArea.BackgroundTransparency = 1
	contentArea.ZIndex = 3
	contentArea.Parent = mainFrame

	local Window = {}
	local tabs = {}

	function Window:CreateTab(tabName)
		local tabBtn = Instance.new("TextButton")
		tabBtn.Name = "Tab_" .. tabName
		tabBtn.Size = UDim2.new(1, 0, 0, 30)
		tabBtn.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
		tabBtn.BackgroundTransparency = 0.5
		tabBtn.Text = tabName
		tabBtn.TextColor3 = Color3.fromRGB(220, 50, 50)
		tabBtn.TextSize = 13
		tabBtn.Font = Enum.Font.SourceSansBold
		tabBtn.ZIndex = 4
		tabBtn.Parent = sidebar

		local tabBtnCorner = Instance.new("UICorner")
		tabBtnCorner.CornerRadius = UDim.new(0, 4)
		tabBtnCorner.Parent = tabBtn

		local tabContent = Instance.new("ScrollingFrame")
		tabContent.Name = "Content_" .. tabName
		tabContent.Size = UDim2.new(1, 0, 1, 0)
		tabContent.BackgroundTransparency = 1
		tabContent.BorderSizePixel = 0
		tabContent.ScrollBarThickness = 4
		tabContent.Visible = false
		tabContent.ZIndex = 4
		tabContent.Parent = contentArea

		local gridLayout = Instance.new("UIGridLayout")
		gridLayout.CellSize = UDim2.new(0, 125, 0, 34)
		gridLayout.CellPadding = UDim2.new(0, 8, 0, 8)
		gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
		gridLayout.Parent = tabContent

		gridLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			tabContent.CanvasSize = UDim2.new(0, 0, 0, gridLayout.AbsoluteContentSize.Y + 12)
		end)

		local function selectTab()
			for _, data in pairs(tabs) do
				data.Content.Visible = false
				data.Button.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
				data.Button.TextColor3 = Color3.fromRGB(220, 50, 50)
			end
			tabContent.Visible = true
			tabBtn.BackgroundColor3 = Color3.fromRGB(0, 40, 180)
			tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		end

		tabBtn.MouseButton1Click:Connect(selectTab)

		table.insert(tabs, {Button = tabBtn, Content = tabContent})

		if #tabs == 1 then
			selectTab()
		end

		local TabObject = {}

		function TabObject:AddButton(text, callback)
			local btn = Instance.new("TextButton")
			btn.Name = "Btn_" .. text
			btn.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
			btn.BackgroundTransparency = 0.2
			btn.Text = text
			btn.TextColor3 = Color3.fromRGB(0, 220, 255)
			btn.TextSize = 12
			btn.Font = Enum.Font.SourceSansBold
			btn.ZIndex = 5
			btn.Parent = tabContent

			local btnCorner = Instance.new("UICorner")
			btnCorner.CornerRadius = UDim.new(0, 4)
			btnCorner.Parent = btn

			btn.MouseButton1Click:Connect(function()
				if callback then task.spawn(callback) end
			end)

			return btn
		end

		function TabObject:AddToggle(text, defaultState, callback)
			local state = defaultState or false

			local btn = Instance.new("TextButton")
			btn.Name = "Toggle_" .. text
			btn.BackgroundColor3 = state and Color3.fromRGB(0, 70, 140) or Color3.fromRGB(20, 20, 26)
			btn.BackgroundTransparency = 0.2
			btn.Text = text .. (state and " [ON]" or " [OFF]")
			btn.TextColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(0, 220, 255)
			btn.TextSize = 12
			btn.Font = Enum.Font.SourceSansBold
			btn.ZIndex = 5
			btn.Parent = tabContent

			local btnCorner = Instance.new("UICorner")
			btnCorner.CornerRadius = UDim.new(0, 4)
			btnCorner.Parent = btn

			btn.MouseButton1Click:Connect(function()
				state = not state
				btn.BackgroundColor3 = state and Color3.fromRGB(0, 70, 140) or Color3.fromRGB(20, 20, 26)
				btn.TextColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(0, 220, 255)
				btn.Text = text .. (state and " [ON]" or " [OFF]")

				if callback then task.spawn(callback, state) end
			end)

			return btn
		end

		return TabObject
	end

	return Window
end

return Library
